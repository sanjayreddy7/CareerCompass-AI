{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://careercompass-ai-p8sc.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://careercompass-ai-p8sc.onrender.com/auth/:path*"
    },
    {
      "source": "/((?!api/|auth/).*)",
      "destination": "/index.html"
    }
  ]
}
