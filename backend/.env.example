# Copy to .env for the backend launcher; never commit local credentials.
DB_URL=jdbc:mysql://localhost:3306/career_compass?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_mysql_username
DB_PASSWORD=replace-with-your-local-password
APP_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
APP_DEMO_DATA=true
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
